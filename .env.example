# Database Connection (SQLite file path or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret (minimum 32 characters)
JWT_SECRET="replace-with-a-secure-random-32-byte-secret"

# Default Admin Credentials for Initial Database Seeding
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Optional SMTP Email Configuration for Consultation Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="trushlegalf@gmail.com"
NOTIFICATION_EMAIL="trushlegalf@gmail.com"

# Public Site URL
NEXT_PUBLIC_SITE_URL="https://trushlegal.com"
